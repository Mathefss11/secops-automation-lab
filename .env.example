# Optional: only needed for `python main.py --threat-intel abuseipdb`.
# The app reads this from the process environment (it does not load .env files).
# Set it in your shell, e.g.:
#   PowerShell:   $env:ABUSEIPDB_API_KEY = "<your key>"
#   bash/zsh:     export ABUSEIPDB_API_KEY="<your key>"
# If you keep a local .env file for your own tooling, it is ignored by Git.
# Never commit a real key.
ABUSEIPDB_API_KEY=your_api_key_here
