/*
 * SecOps Automation Lab - portfolio / learning rule.
 *
 * YARA-L 2.0 equivalent of the local Python detection
 * "Credential Attack Followed by Successful Authentication"
 * (src/detection_engine.py: detect_credential_attack).
 *
 * Written from the official Google SecOps YARA-L 2.0 and UDM documentation
 * (see docs/google-secops.md). It has NOT been deployed to, compiled by or run
 * in a Google SecOps tenant. Validate it in a tenant before any real use.
 */

rule credential_attack_followed_by_successful_authentication {

  meta:
    author = "SecOps Automation Lab (portfolio)"
    description = "Five or more failed logins against three or more distinct accounts from one source IP to one host, followed by a successful login from that IP to that host within 5 minutes. Not classified as password spraying: UDM login events do not show whether the same password was tried across accounts."
    rule_name = "Credential Attack Followed by Successful Authentication"
    severity = "High"
    priority = "High"
    tactic = "TA0006"
    technique = "T1110"
    data_source = "any source parsed to UDM USER_LOGIN events (for example sshd or Windows Security logons)"
    assumption = "The parser sets security_result.action to BLOCK for failed and ALLOW for successful logins, principal.ip to the client IP and target.hostname to the host being logged into."
    local_equivalent = "src/detection_engine.py detect_credential_attack"
    disclaimer = "Portfolio rule written from official documentation; not validated in a live Google SecOps tenant."

  events:
    // Failed logins. One $failed_login variable represents every matching failure.
    $failed_login.metadata.event_type = "USER_LOGIN"
    $failed_login.security_result.action = "BLOCK"
    $failed_login.principal.ip = $source_ip
    $failed_login.target.hostname = $target_host
    $failed_login.target.user.userid = $failed_account

    // A successful login from the same source IP to the same host.
    $successful_login.metadata.event_type = "USER_LOGIN"
    $successful_login.security_result.action = "ALLOW"
    $successful_login.principal.ip = $source_ip
    $successful_login.target.hostname = $target_host

    // The failures must come before the success.
    $failed_login.metadata.event_timestamp.seconds <= $successful_login.metadata.event_timestamp.seconds

  match:
    // Correlate per source IP and target host inside a 5 minute window.
    $source_ip, $target_host over 5m

  outcome:
    $failed_login_threshold = 5
    $distinct_account_threshold = 3
    $failed_login_count = count_distinct($failed_login.metadata.id)
    $targeted_account_count = count_distinct($failed_login.target.user.userid)
    $targeted_accounts = array_distinct($failed_login.target.user.userid)
    $authenticated_account = array_distinct($successful_login.target.user.userid)
    $first_failure_time = min($failed_login.metadata.event_timestamp.seconds)
    $success_time = max($successful_login.metadata.event_timestamp.seconds)

  condition:
    // #failed_login counts distinct failed-login events;
    // #failed_account counts distinct values of the targeted account.
    #failed_login >= 5 and #failed_account >= 3 and $successful_login
}
